{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchouli:schema:knowledge:1",
  "title": "Patchouli Knowledge value version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["content", "metadata", "artifact", "profile"],
  "properties": {
    "content": { "$ref": "#/$defs/content" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "artifact": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" },
      "maxItems": 32
    },
    "profile": { "$ref": "#/$defs/profile" }
  },
  "$defs": {
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "structured" },
            "value": {}
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "extensions"],
      "properties": {
        "core": {
          "allOf": [
            { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/metadata_core" },
            {
              "type": "object",
              "required": ["schema"],
              "properties": {
                "schema": { "const": "patchouli.knowledge@1" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        "extensions": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/extensions" }
      }
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role", "media_type", "digest", "metadata"],
      "properties": {
        "ref": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/non_empty_string" },
        "role": { "type": "string", "enum": ["source", "attachment"] },
        "media_type": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "digest": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/non_empty_string" },
        "metadata": { "type": "object" }
      }
    },
    "embedding_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role", "media_type", "digest", "metadata"],
      "properties": {
        "ref": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/non_empty_string" },
        "role": { "const": "embedding" },
        "media_type": { "const": "application/vnd.patchouli.embedding" },
        "digest": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/non_empty_string" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "dimensions", "metric", "source_version"],
          "properties": {
            "model": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/non_empty_string" },
            "dimensions": { "type": "integer", "minimum": 1 },
            "metric": { "type": "string", "enum": ["cosine", "dot_product", "euclidean"] },
            "source_version": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/non_empty_string" }
          }
        }
      }
    },
    "artifact": {
      "oneOf": [
        { "$ref": "#/$defs/source_artifact" },
        { "$ref": "#/$defs/embedding_artifact" }
      ]
    },
    "temporal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["unknown", "timeless"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "at"],
          "properties": {
            "kind": { "const": "instant" },
            "at": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/timestamp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": { "const": "interval" },
            "start": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/timestamp" },
            "end": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/timestamp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "items"],
          "properties": {
            "kind": { "const": "sequence" },
            "items": {
              "type": "array",
              "items": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/knowledge_ref" },
              "minItems": 1,
              "maxItems": 256
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epistemic", "temporal", "ownership", "abstraction", "persistence", "retrieval", "actionability"],
      "properties": {
        "epistemic": {
          "type": "string",
          "enum": ["unknown", "observation", "hypothesis", "belief", "knowledge", "derived"]
        },
        "temporal": { "$ref": "#/$defs/temporal" },
        "ownership": {
          "type": "string",
          "enum": ["unknown", "world", "agent", "user", "shared"]
        },
        "abstraction": {
          "type": "string",
          "enum": ["unknown", "instance", "pattern", "concept", "rule"]
        },
        "persistence": {
          "type": "string",
          "enum": ["unknown", "working", "short_term", "long_term", "permanent"]
        },
        "retrieval": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["unknown", "exact", "associative", "contextual", "causal", "procedural"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "actionability": {
          "type": "string",
          "enum": ["unknown", "informational", "directive", "constraint"]
        }
      }
    }
  }
}
