{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchouli:schema:knowledge-relation:1",
  "title": "Patchouli KnowledgeRelation value version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "from", "to", "metadata"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["supports", "contradicts", "derived_from", "generalized_from", "causes", "supersedes"]
    },
    "from": {
      "type": "array",
      "items": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/knowledge_ref" },
      "minItems": 1,
      "uniqueItems": true
    },
    "to": {
      "type": "array",
      "items": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/knowledge_ref" },
      "minItems": 1,
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "extensions"],
      "properties": {
        "core": {
          "allOf": [
            { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/metadata_core" },
            {
              "type": "object",
              "required": ["schema"],
              "properties": {
                "schema": { "const": "patchouli.knowledge-relation@1" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        "extensions": { "$ref": "urn:patchouli:schema:fact-common:1#/$defs/extensions" }
      }
    }
  }
}
