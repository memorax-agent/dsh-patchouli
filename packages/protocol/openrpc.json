{
  "$schema": "https://meta.open-rpc.org/",
  "openrpc": "1.3.2",
  "info": {
    "title": "Patchouli Storage Protocol",
    "version": "1.0.0-draft.6",
    "description": "Harness-neutral transactional CRUD and reactive change protocol for generic JSON entities.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/license/mit"
    }
  },
  "methods": [
    {
      "name": "patchouli.protocol.handshake@1",
      "summary": "Negotiate protocol version and capabilities",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "client",
          "required": true,
          "schema": { "$ref": "#/components/schemas/ClientIdentity" }
        },
        {
          "name": "protocol_versions",
          "required": true,
          "schema": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        {
          "name": "capabilities",
          "required": true,
          "schema": { "$ref": "#/components/schemas/CapabilityList" }
        }
      ],
      "result": {
        "name": "handshake",
        "required": true,
        "schema": { "$ref": "#/components/schemas/HandshakeResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/UnsupportedCapability" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.control.status@1",
      "summary": "Report daemon readiness and process identity",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        {
          "name": "data",
          "required": true,
          "schema": { "$ref": "#/components/schemas/EmptyData" }
        }
      ],
      "result": {
        "name": "status",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ControlStatusResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.control.checkpoint@1",
      "summary": "Checkpoint durable provider state without stopping the daemon",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        {
          "name": "data",
          "required": true,
          "schema": { "$ref": "#/components/schemas/EmptyData" }
        }
      ],
      "result": {
        "name": "checkpoint",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ControlCheckpointResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.control.shutdown@1",
      "summary": "Ask the local daemon to shut down cleanly",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        {
          "name": "data",
          "required": true,
          "schema": { "$ref": "#/components/schemas/EmptyData" }
        }
      ],
      "result": {
        "name": "shutdown",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ControlShutdownResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" }
      ]
    },
    {
      "name": "patchouli.entity.create@1",
      "summary": "Durably accept one generic entity creation",
      "description": "The Rust backend controller validates the candidate and atomically records its immutable version, visible heads, CRDT frontier, and change-log entry.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/CreateEntityData" }
      ],
      "result": {
        "name": "mutation",
        "required": true,
        "schema": { "$ref": "#/components/schemas/MutationResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/VersionConflict" },
        { "$ref": "#/components/errors/WorkUnitExpired" },
        { "$ref": "#/components/errors/IdempotencyConflict" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.artifact.upload.begin@1",
      "summary": "Begin a backend-managed Artifact upload",
      "description": "Creates an ephemeral upload capability. The Artifact entity is not created or published until commit.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/ArtifactUploadBeginData" }
      ],
      "result": {
        "name": "upload",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ArtifactUploadBeginResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.artifact.upload.chunk@1",
      "summary": "Append one ordered chunk to an Artifact upload",
      "description": "Chunks are Base64 encoded and must start at the exact next offset returned by the previous call.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/ArtifactUploadChunkData" }
      ],
      "result": {
        "name": "chunk",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ArtifactUploadChunkResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/NotFound" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.artifact.upload.commit@1",
      "summary": "Commit an upload and create its managed Artifact entity",
      "description": "Verifies byte length and SHA-256, atomically publishes the content-addressed object, then creates the Artifact through the configured generic entity controller.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/ArtifactUploadCommitData" }
      ],
      "result": {
        "name": "mutation",
        "required": true,
        "schema": { "$ref": "#/components/schemas/MutationResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/NotFound" },
        { "$ref": "#/components/errors/VersionConflict" },
        { "$ref": "#/components/errors/WorkUnitExpired" },
        { "$ref": "#/components/errors/IdempotencyConflict" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.artifact.download.chunk@1",
      "summary": "Read one chunk of a backend-managed Artifact",
      "description": "Resolves the Artifact entity inside the configured request scope before reading its managed placement. Indexed Artifacts remain with their source provider.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/ArtifactDownloadChunkData" }
      ],
      "result": {
        "name": "chunk",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ArtifactDownloadChunkResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/NotFound" },
        { "$ref": "#/components/errors/VersionConflict" },
        { "$ref": "#/components/errors/UnsupportedCapability" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.entity.read@1",
      "summary": "Read the current versions of one entity",
      "description": "The result is read from one database snapshot. A missing identity returns NOT_FOUND; a retained tombstone returns state deleted.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/ReadEntityData" }
      ],
      "result": {
        "name": "entity",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ReadEntityResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/NotFound" },
        { "$ref": "#/components/errors/WorkUnitExpired" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.entity.retrieve@1",
      "summary": "Retrieve relevant entities in the configured scope",
      "description": "The provider searches active entity values and returns matching current variants ordered by relevance.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/RetrieveEntitiesData" }
      ],
      "result": {
        "name": "entities",
        "required": true,
        "schema": { "$ref": "#/components/schemas/RetrieveEntitiesResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.entity.update@1",
      "summary": "Durably accept one generic entity replacement",
      "description": "Configured conflict metadata must satisfy the selected policy. The controller resolves CRDT/MVCC variants before atomically comparing and replacing the visible head set.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/UpdateEntityData" }
      ],
      "result": {
        "name": "mutation",
        "required": true,
        "schema": { "$ref": "#/components/schemas/MutationResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/NotFound" },
        { "$ref": "#/components/errors/VersionConflict" },
        { "$ref": "#/components/errors/WorkUnitExpired" },
        { "$ref": "#/components/errors/IdempotencyConflict" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.entity.delete@1",
      "summary": "Durably accept one generic entity tombstone",
      "description": "Delete is logical. The tombstone, visible head set, and change-log entry are recorded atomically.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/DeleteEntityData" }
      ],
      "result": {
        "name": "mutation",
        "required": true,
        "schema": { "$ref": "#/components/schemas/MutationResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/InvalidRequest" },
        { "$ref": "#/components/errors/NotFound" },
        { "$ref": "#/components/errors/VersionConflict" },
        { "$ref": "#/components/errors/WorkUnitExpired" },
        { "$ref": "#/components/errors/IdempotencyConflict" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.changes.subscribe@1",
      "summary": "Start or resume a change stream",
      "description": "The server returns the stream boundary cursor before sending events for this subscription.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/SubscribeChangesData" }
      ],
      "result": {
        "name": "subscription",
        "required": true,
        "schema": { "$ref": "#/components/schemas/SubscribeChangesResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" },
        { "$ref": "#/components/errors/CursorExpired" },
        { "$ref": "#/components/errors/DeadlineExceeded" },
        { "$ref": "#/components/errors/Overloaded" }
      ]
    },
    {
      "name": "patchouli.changes.unsubscribe@1",
      "summary": "Stop a connection-local subscription",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/UnsubscribeChangesData" }
      ],
      "result": {
        "name": "unsubscription",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UnsubscribeChangesResult" }
      },
      "errors": [
        { "$ref": "#/components/errors/Unauthenticated" },
        { "$ref": "#/components/errors/Forbidden" }
      ]
    },
    {
      "name": "patchouli.changes.event@1",
      "summary": "Deliver one published change",
      "description": "Server-to-client JSON-RPC notification. It has no id and no result.",
      "paramStructure": "by-name",
      "params": [
        { "$ref": "#/components/contentDescriptors/Meta" },
        { "$ref": "#/components/contentDescriptors/ChangesEventData" }
      ]
    }
  ],
  "components": {
    "contentDescriptors": {
      "Meta": {
        "name": "meta",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Meta" }
      },
      "CreateEntityData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/CreateEntityData" }
      },
      "ArtifactUploadBeginData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ArtifactUploadBeginData" }
      },
      "ArtifactUploadChunkData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ArtifactUploadChunkData" }
      },
      "ArtifactUploadCommitData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ArtifactUploadCommitData" }
      },
      "ArtifactDownloadChunkData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ArtifactDownloadChunkData" }
      },
      "ReadEntityData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ReadEntityData" }
      },
      "RetrieveEntitiesData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/RetrieveEntitiesData" }
      },
      "UpdateEntityData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UpdateEntityData" }
      },
      "DeleteEntityData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/DeleteEntityData" }
      },
      "SubscribeChangesData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/SubscribeChangesData" }
      },
      "UnsubscribeChangesData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UnsubscribeChangesData" }
      },
      "ChangesEventData": {
        "name": "data",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ChangesEventData" }
      }
    },
    "schemas": {
      "NonEmptyString": {
        "type": "string",
        "minLength": 1
      },
      "OpaqueToken": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque to clients; equality is the only supported operation."
      },
      "Meta": {
        "type": "object",
        "properties": {
          "deadline_unix_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional absolute Unix-millisecond deadline for database acceptance."
          }
        },
        "additionalProperties": true,
        "description": "Controller metadata interpreted by backend configuration. meta.deadline_unix_ms is reserved as an optional unsigned Unix-millisecond acceptance deadline; configured fields may select consistency and conflict behavior."
      },
      "CapabilityList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/NonEmptyString" },
        "uniqueItems": true,
        "description": "Capability names supported or negotiated by both peers."
      },
      "ClientIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "instance_id"],
        "properties": {
          "name": { "$ref": "#/components/schemas/NonEmptyString" },
          "version": { "$ref": "#/components/schemas/NonEmptyString" },
          "instance_id": { "$ref": "#/components/schemas/NonEmptyString" }
        }
      },
      "HandshakeResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol_version", "server", "capabilities", "limits"],
        "properties": {
          "protocol_version": { "const": 1 },
          "server": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "cluster_id", "node_id"],
            "properties": {
              "version": { "$ref": "#/components/schemas/NonEmptyString" },
              "cluster_id": { "$ref": "#/components/schemas/NonEmptyString" },
              "node_id": { "$ref": "#/components/schemas/NonEmptyString" }
            }
          },
          "capabilities": { "$ref": "#/components/schemas/CapabilityList" },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_request_bytes",
              "max_artifact_chunk_bytes",
              "max_result_items",
              "idempotency_retention_seconds",
              "change_retention_seconds"
            ],
            "properties": {
              "max_request_bytes": { "type": "integer", "minimum": 1 },
              "max_artifact_chunk_bytes": { "type": "integer", "minimum": 1 },
              "max_result_items": { "type": "integer", "minimum": 1 },
              "idempotency_retention_seconds": { "type": "integer", "minimum": 1 },
              "change_retention_seconds": { "type": "integer", "minimum": 1 }
            }
          }
        }
      },
      "EmptyData": {
        "type": "object",
        "additionalProperties": false
      },
      "ControlStatusResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meta", "data"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ready", "provider", "generation", "recovered_after_unclean_shutdown", "pid", "started_at_unix_ms", "active_connections"],
            "properties": {
              "ready": { "type": "boolean" },
              "provider": { "type": "string", "minLength": 1 },
              "generation": { "type": "integer", "minimum": 1 },
              "recovered_after_unclean_shutdown": { "type": "boolean" },
              "pid": { "type": "integer", "minimum": 1 },
              "started_at_unix_ms": { "type": "integer", "minimum": 0 },
              "active_connections": { "type": "integer", "minimum": 0 }
            }
          }
        }
      },
      "ControlCheckpointResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meta", "data"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["completed"],
            "properties": {
              "completed": { "type": "boolean" }
            }
          }
        }
      },
      "ControlShutdownResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meta", "data"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["accepted"],
            "properties": {
              "accepted": { "type": "boolean" }
            }
          }
        }
      },
      "EntityRef": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": { "$ref": "#/components/schemas/NonEmptyString" },
          "id": { "$ref": "#/components/schemas/NonEmptyString" }
        }
      },
      "ArtifactUploadBeginData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_type",
          "name",
          "expected_byte_length",
          "expected_digest",
          "metadata"
        ],
        "properties": {
          "id": { "$ref": "#/components/schemas/NonEmptyString" },
          "media_type": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "name": {
            "oneOf": [
              { "$ref": "#/components/schemas/NonEmptyString" },
              { "type": "null" }
            ]
          },
          "expected_byte_length": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "null" }
            ]
          },
          "expected_digest": {
            "oneOf": [
              { "$ref": "#/components/schemas/NonEmptyString" },
              { "type": "null" }
            ]
          },
          "metadata": { "type": "object" }
        }
      },
      "ArtifactUploadBeginResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meta", "data"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["upload_id", "max_chunk_bytes"],
            "properties": {
              "upload_id": { "$ref": "#/components/schemas/OpaqueToken" },
              "max_chunk_bytes": { "type": "integer", "minimum": 1 }
            }
          }
        }
      },
      "ArtifactUploadChunkData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["upload_id", "offset", "bytes_base64"],
        "properties": {
          "upload_id": { "$ref": "#/components/schemas/OpaqueToken" },
          "offset": { "type": "integer", "minimum": 0 },
          "bytes_base64": {
            "type": "string",
            "minLength": 1,
            "contentEncoding": "base64"
          }
        }
      },
      "ArtifactUploadChunkResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meta", "data"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["next_offset"],
            "properties": {
              "next_offset": { "type": "integer", "minimum": 1 }
            }
          }
        }
      },
      "ArtifactUploadCommitData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["upload_id"],
        "properties": {
          "upload_id": { "$ref": "#/components/schemas/OpaqueToken" }
        }
      },
      "ArtifactDownloadChunkData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "offset", "max_bytes"],
        "properties": {
          "id": { "$ref": "#/components/schemas/NonEmptyString" },
          "version": {
            "oneOf": [
              { "$ref": "#/components/schemas/OpaqueToken" },
              { "type": "null" }
            ]
          },
          "offset": { "type": "integer", "minimum": 0 },
          "max_bytes": { "type": "integer", "minimum": 1 }
        }
      },
      "ArtifactDownloadChunkResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meta", "data"],
        "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "data": {
            "type": "object",
            "additionalProperties": false,
