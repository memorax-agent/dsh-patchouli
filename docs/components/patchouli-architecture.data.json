  "nodeCopy": {
    "en": {
      "boundary": {
        "label": "DeepSeek Harness",
        "role": "",
        "description": ""
      },
      "agent": {
        "label": "Agent Loop Plugin",
        "role": "Application",
        "description": "Produces Hook, Tool, and committed-turn data, then accepts recalled context through official Agent Loop extension points."
      },
      "other": {
        "label": "Other plugins",
        "role": "Application",
        "description": "Call the common service directly with trusted source identity, scope, and source-owned JSON data."
      },
      "connector": {
        "label": "Agent Loop connector",
        "role": "Adapter plugin",
        "description": "Maps official Agent Loop extension points to lossless update and retrieve calls without owning memory semantics."
      },
      "coordinator": {
        "label": "Patchouli coord hub",
        "role": "Core plugin",
        "description": "Routes update, retrieve, and subscribe calls, isolates failures, and preserves the provenance of every plugin outcome."
      },
      "plugins": {
        "label": "Memory / knowledge plugins",
        "role": "Capability plugins",
        "description": "Own extraction, retrieval, ranking, and provider-specific memory semantics while registering their own routing filters."
      },
      "backend": {
        "label": "Patchouli backend & database ",
        "role": "Patchouli-db",
        "description": "Applies configured identity, consistency, transaction, and conflict policy before durable local or remote provider operations."
      }
    },
    "zh": {
      "boundary": {
        "label": "DeepSeek Harness",
        "role": "",
        "description": ""
      },
      "agent": {
        "label": "Agent Loop Plugin",
        "role": "应用插件",
        "description": "通过官方 Agent Loop 扩展点提供 Hook、Tool 和已提交 Turn 数据，并接收召回上下文。"
      },
      "other": {
        "label": "其他插件",
        "role": "应用插件",
        "description": "携带可信来源身份、Scope 和来源自有 JSON 数据，直接调用统一服务。"
      },
      "connector": {
        "label": "Agent Loop 连接器",
        "role": "适配插件",
        "description": "将官方 Agent Loop 扩展点映射为无损 Update/Retrieve 调用，本身不拥有记忆语义。"
      },
      "coordinator": {
        "label": "Patchouli 协调中台",
        "role": "核心插件",
        "description": "路由 Update、Retrieve 与 Subscribe，隔离插件故障，并保留每项结果的插件来源。"
      },
      "plugins": {
        "label": "记忆 / 知识插件",
        "role": "能力插件",
        "description": "拥有抽取、检索、排序和 Provider 特定的记忆语义，并通过自己的 Filter 控制路由。"
      },
      "backend": {
        "label": "Patchouli 后端 & 数据库",
        "role": "Patchouli-db",
        "description": "在本地或远程 Provider 操作前执行配置化身份、一致性、事务与冲突处理策略。"
      }
    }
  },
