{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patchouli backend configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "meta_fields", "entity_identity", "entity_types"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "meta_fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/non_empty_string" },
      "additionalProperties": { "$ref": "#/$defs/meta_field" }
    },
    "entity_identity": { "$ref": "#/$defs/entity_identity" },
    "entity_types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/non_empty_string" },
      "additionalProperties": { "$ref": "#/$defs/entity_policy" }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "alias": {
      "$ref": "#/$defs/non_empty_string"
    },
    "alias_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" },
      "uniqueItems": true
    },
    "non_empty_alias_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" },
      "minItems": 1,
      "uniqueItems": true
    },
    "json_schema": {
      "type": ["object", "boolean"]
    },
    "meta_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "schema"],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "schema": { "$ref": "#/$defs/json_schema" }
      }
    },
    "entity_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_by"],
      "properties": {
        "scope_by": { "$ref": "#/$defs/alias_list" }
      }
    },
    "entity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_schema", "rules", "fallback"],
      "properties": {
        "value_schema": { "$ref": "#/$defs/json_schema" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/policy_rule" }
        },
        "fallback": { "$ref": "#/$defs/behavior" }
      }
    },
    "policy_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "behavior"],
      "properties": {
        "name": { "$ref": "#/$defs/non_empty_string" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["all_present"],
          "properties": {
            "all_present": { "$ref": "#/$defs/non_empty_alias_list" }
          }
        },
        "behavior": { "$ref": "#/$defs/behavior" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consistency", "idempotency", "conflict", "publication"],
      "properties": {
        "consistency": { "$ref": "#/$defs/consistency_policy" },
        "idempotency": { "$ref": "#/$defs/idempotency" },
        "conflict": { "$ref": "#/$defs/conflict" },
        "publication": { "$ref": "#/$defs/publication" }
      }
    },
    "consistency_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "acquire", "sessions", "commit"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/snapshot_policy" },
        "acquire": { "$ref": "#/$defs/acquire_policy" },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/session_policy" },
          "uniqueItems": true
        },
        "commit": { "$ref": "#/$defs/commit_consistency" }
      }
    },
    "snapshot_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "request" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "key_by"],
          "properties": {
            "mode": { "const": "shared" },
            "key_by": { "$ref": "#/$defs/non_empty_alias_list" }
          }
        }
      ]
    },
    "acquire_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_sources", "requirements"],
      "properties": {
        "allow_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/consistency_source" },
          "minItems": 1,
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/acquire_requirement" },
          "uniqueItems": true
        }
      }
    },
    "consistency_source": {
      "type": "string",
      "enum": ["authority", "replica"]
    },
    "acquire_requirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "token"],
          "properties": {
            "kind": { "const": "causal_after" },
            "token": { "$ref": "#/$defs/alias" },
            "optional": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key_by"],
          "properties": {
            "kind": { "const": "linearizable" },
            "key_by": { "$ref": "#/$defs/alias_list" }
          }
        }
      ]
    },
    "session_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_by", "guarantees"],
      "properties": {
        "key_by": { "$ref": "#/$defs/non_empty_alias_list" },
        "guarantees": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["monotonic_reads", "read_your_writes"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "commit_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordering"],
      "properties": {
        "ordering": { "$ref": "#/$defs/commit_ordering" }
      }
    },
    "commit_ordering": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "none" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key_by"],
          "properties": {
            "kind": { "const": "serialize" },
            "key_by": { "$ref": "#/$defs/alias_list" }
          }
        }
      ]
    },
    "idempotency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "disabled" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "key_by"],
          "properties": {
            "mode": { "const": "keyed" },
            "key_by": { "$ref": "#/$defs/non_empty_alias_list" }
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_strategy",
        "strategy_from",
        "base_versions",
        "merge",
        "otherwise"
      ],
      "properties": {
        "default_strategy": {
          "type": "string",
          "enum": ["merge", "mvcc", "reject"]
        },
        "strategy_from": { "$ref": "#/$defs/alias" },
        "base_versions": { "$ref": "#/$defs/alias" },
        "merge": {
          "type": "array",
          "items": { "$ref": "#/$defs/conflict_merge_rule" }
        },
        "otherwise": {
          "type": "string",
          "enum": ["mvcc", "reject"]
        }
      }
    },
    "conflict_merge_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "strategy", "group_by"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "strategy": { "const": "automerge" },
        "group_by": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "uniqueItems": true
        }
      }
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "immediate" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "key_by",
            "close_when",
            "staging_ttl_ms",
            "on_expire"
          ],
          "properties": {
            "mode": { "const": "batch" },
            "key_by": { "$ref": "#/$defs/non_empty_alias_list" },
            "close_when": { "$ref": "#/$defs/close_condition" },
            "staging_ttl_ms": {
              "type": "integer",
              "minimum": 1
            },
            "on_expire": {
              "type": "string",
              "enum": ["discard", "publish"]
            }
          }
        }
      ]
    },
    "close_condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field", "equals"],
          "properties": {
            "kind": { "const": "marker" },
            "field": { "$ref": "#/$defs/alias" },
            "equals": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field"],
          "properties": {
            "kind": { "const": "expected_count" },
            "field": { "$ref": "#/$defs/alias" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field", "size_ms"],
          "properties": {
            "kind": { "const": "time_window" },
            "field": { "$ref": "#/$defs/alias" },
            "size_ms": {
              "type": "integer",
              "minimum": 1
            },
            "allowed_lateness_ms": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        }
      ]
    }
  }
}
