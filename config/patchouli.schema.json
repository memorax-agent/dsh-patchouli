{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patchouli backend configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "meta_fields", "entity_identity", "entity_types"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "meta_fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/non_empty_string" },
      "additionalProperties": { "$ref": "#/$defs/meta_field" }
    },
    "entity_identity": { "$ref": "#/$defs/entity_identity" },
    "entity_types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/non_empty_string" },
      "additionalProperties": { "$ref": "#/$defs/entity_policy" }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "alias": {
      "$ref": "#/$defs/non_empty_string"
    },
    "alias_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" },
      "uniqueItems": true
    },
    "non_empty_alias_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" },
      "minItems": 1,
      "uniqueItems": true
    },
    "json_schema": {
      "type": ["object", "boolean"]
    },
    "meta_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "schema"],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "schema": { "$ref": "#/$defs/json_schema" }
      }
    },
    "entity_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_by"],
      "properties": {
        "scope_by": { "$ref": "#/$defs/alias_list" }
      }
    },
    "entity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_schema", "rules", "fallback"],
      "properties": {
        "value_schema": { "$ref": "#/$defs/json_schema" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/policy_rule" }
        },
        "fallback": { "$ref": "#/$defs/behavior" }
      }
    },
    "policy_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "behavior"],
      "properties": {
        "name": { "$ref": "#/$defs/non_empty_string" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["all_present"],
          "properties": {
            "all_present": { "$ref": "#/$defs/non_empty_alias_list" }
          }
        },
        "behavior": { "$ref": "#/$defs/behavior" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "idempotency", "conflict", "publication"],
      "properties": {
        "baseline": { "$ref": "#/$defs/baseline" },
        "idempotency": { "$ref": "#/$defs/idempotency" },
        "conflict": { "$ref": "#/$defs/conflict" },
        "publication": { "$ref": "#/$defs/publication" }
      }
    },
    "baseline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "consistency", "source"],
          "properties": {
            "mode": { "const": "request" },
            "consistency": { "$ref": "#/$defs/consistency" },
            "source": { "$ref": "#/$defs/baseline_source" },
            "at": { "$ref": "#/$defs/alias" },
            "causal_token": { "$ref": "#/$defs/alias" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "consistency", "source", "key_by"],
          "properties": {
            "mode": { "const": "shared" },
            "consistency": { "$ref": "#/$defs/consistency" },
            "source": { "$ref": "#/$defs/baseline_source" },
            "key_by": { "$ref": "#/$defs/non_empty_alias_list" },
            "at": { "$ref": "#/$defs/alias" },
            "causal_token": { "$ref": "#/$defs/alias" }
          }
        }
      ]
    },
    "consistency": {
      "type": "string",
      "enum": ["eventual", "causal", "linearizable"]
    },
    "baseline_source": {
      "type": "string",
      "enum": ["any", "authority", "replica"]
    },
    "idempotency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "disabled" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "key_by"],
          "properties": {
            "mode": { "const": "keyed" },
            "key_by": { "$ref": "#/$defs/non_empty_alias_list" }
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "base_versions"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["reject", "preserve_heads"]
        },
        "base_versions": { "$ref": "#/$defs/alias" }
      }
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "immediate" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "key_by",
            "close_when",
            "staging_ttl_ms",
            "on_expire"
          ],
          "properties": {
            "mode": { "const": "batch" },
            "key_by": { "$ref": "#/$defs/non_empty_alias_list" },
            "close_when": { "$ref": "#/$defs/close_condition" },
            "staging_ttl_ms": {
              "type": "integer",
              "minimum": 1
            },
            "on_expire": {
              "type": "string",
              "enum": ["discard", "publish"]
            }
          }
        }
      ]
    },
    "close_condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field", "equals"],
          "properties": {
            "kind": { "const": "marker" },
            "field": { "$ref": "#/$defs/alias" },
            "equals": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field"],
          "properties": {
            "kind": { "const": "expected_count" },
            "field": { "$ref": "#/$defs/alias" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field", "size_ms"],
          "properties": {
            "kind": { "const": "time_window" },
            "field": { "$ref": "#/$defs/alias" },
            "size_ms": {
              "type": "integer",
              "minimum": 1
            },
            "allowed_lateness_ms": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        }
      ]
    }
  }
}
