{
  "$schema": "../patchouli.schema.json",
  "version": 1,
  "meta_fields": {
    "channel_id": {
      "pointer": "/channel_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "conflict_strategy": {
      "pointer": "/conflict_strategy",
      "schema": { "type": "string", "enum": ["merge", "mvcc", "reject"] }
    },
    "base_versions": {
      "pointer": "/base_versions",
      "schema": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "uniqueItems": true
      }
    }
  },
  "entity_identity": {
    "scope_by": ["channel_id"]
  },
  "entity_types": {
    "knowledge": {
      "value_schema": {
        "$ref": "urn:patchouli:schema:knowledge:1"
      },
      "rules": [],
      "fallback": {
        "consistency": {
          "snapshot": {
            "mode": "request"
          },
          "acquire": {
            "allow_sources": ["authority", "replica"],
            "requirements": []
          },
          "sessions": [],
          "commit": {
            "ordering": {
              "kind": "none"
            }
          }
        },
        "idempotency": {
          "mode": "disabled"
        },
        "conflict": {
          "default_strategy": "mvcc",
          "strategy_from": "conflict_strategy",
          "base_versions": "base_versions",
          "merge": [
            {
              "path": "/content",
              "strategy": "automerge",
              "group_by": ["/kind"]
            }
          ],
          "otherwise": "mvcc"
        },
        "publication": {
          "mode": "immediate"
        }
      }
    }
  }
}
