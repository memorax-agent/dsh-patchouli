{
  "$schema": "../patchouli.schema.json",
  "version": 1,
  "meta_fields": {
    "channel_id": {
      "pointer": "/channel_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "transaction_id": {
      "pointer": "/transaction_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "participant_id": {
      "pointer": "/plugin_route_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "request_id": {
      "pointer": "/request_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "transaction_state": {
      "pointer": "/transaction_state",
      "schema": { "type": "string" }
    },
    "causal_token": {
      "pointer": "/causal_token",
      "schema": { "type": "string", "minLength": 1 }
    },
    "base_versions": {
      "pointer": "/base_versions",
      "schema": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "uniqueItems": true
      }
    }
  },
  "entity_identity": {
    "scope_by": ["channel_id"]
  },
  "entity_types": {
    "knowledge": {
      "value_schema": {
        "$ref": "urn:patchouli:schema:knowledge:1"
      },
      "rules": [],
      "fallback": {
        "consistency": {
          "snapshot": {
            "mode": "shared",
            "key_by": ["transaction_id"]
          },
          "acquire": {
            "allow_sources": ["authority"],
            "requirements": [
              {
                "kind": "causal_after",
                "token": "causal_token",
                "optional": true
              }
            ]
          },
          "sessions": [
            {
              "key_by": ["participant_id"],
              "guarantees": ["monotonic_reads", "read_your_writes"]
            }
          ],
          "commit": {
            "ordering": {
              "kind": "serialize",
              "key_by": []
            }
          }
        },
        "idempotency": {
          "mode": "keyed",
          "key_by": ["transaction_id", "participant_id", "request_id"]
        },
        "conflict": {
          "strategy": "preserve_heads",
          "base_versions": "base_versions"
        },
        "publication": {
          "mode": "batch",
          "key_by": ["transaction_id"],
          "close_when": {
            "kind": "marker",
            "field": "transaction_state",
            "equals": "commit"
          },
          "staging_ttl_ms": 3600000,
          "on_expire": "discard"
        }
      }
    }
  }
}
