{
  "$schema": "./patchouli.schema.json",
  "version": 1,
  "meta_fields": {
    "channel_id": {
      "pointer": "/channel_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "conflict_strategy": {
      "pointer": "/conflict_strategy",
      "schema": { "type": "string", "enum": ["merge", "mvcc", "reject"] }
    },
    "transaction_id": {
      "pointer": "/transaction_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "event_time": {
      "pointer": "/event_time",
      "schema": { "type": "string", "format": "date-time" }
    },
    "participant_id": {
      "pointer": "/plugin_route_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "request_id": {
      "pointer": "/request_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "transaction_state": {
      "pointer": "/transaction_state",
      "schema": { "type": "string" }
    },
    "causal_token": {
      "pointer": "/causal_token",
      "schema": { "type": "string", "minLength": 1 }
    },
    "base_versions": {
      "pointer": "/base_versions",
      "schema": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "uniqueItems": true
      }
    }
  },
  "entity_identity": {
    "scope_by": ["channel_id"]
  },
  "entity_types": {
    "knowledge": {
      "value_schema": {
        "$ref": "urn:patchouli:schema:knowledge:1"
      },
      "rules": [
        {
          "name": "transaction_batch",
          "when": {
            "all_present": ["transaction_id", "participant_id", "request_id"]
          },
          "behavior": {
            "consistency": {
              "snapshot": {
                "mode": "shared",
                "key_by": ["transaction_id"]
              },
              "acquire": {
                "allow_sources": ["authority"],
                "requirements": [
                  {
                    "kind": "causal_after",
                    "token": "causal_token",
                    "optional": true
                  }
                ]
              },
              "sessions": [
                {
                  "key_by": ["participant_id"],
                  "guarantees": ["monotonic_reads", "read_your_writes"]
                }
              ],
              "commit": {
                "ordering": {
                  "kind": "serialize",
                  "key_by": []
                }
              }
            },
            "idempotency": {
              "mode": "keyed",
              "key_by": ["transaction_id", "participant_id", "request_id"]
            },
            "conflict": {
              "default_strategy": "merge",
              "strategy_from": "conflict_strategy",
              "base_versions": "base_versions",
              "merge": [
                {
                  "path": "/content",
                  "strategy": "automerge",
                  "group_by": ["/kind"]
                }
              ],
              "otherwise": "mvcc"
            },
            "publication": {
              "mode": "batch",
              "key_by": ["transaction_id"],
              "close_when": {
                "kind": "marker",
                "field": "transaction_state",
                "equals": "commit"
              },
              "staging_ttl_ms": 3600000,
              "on_expire": "discard"
            }
          }
        }
      ],
      "fallback": {
        "consistency": {
          "snapshot": {
            "mode": "request"
          },
          "acquire": {
            "allow_sources": ["authority"],
            "requirements": [
              {
                "kind": "linearizable",
                "key_by": []
              }
            ]
          },
          "sessions": [],
          "commit": {
            "ordering": {
              "kind": "serialize",
              "key_by": []
            }
          }
        },
        "idempotency": {
          "mode": "disabled"
        },
        "conflict": {
          "default_strategy": "merge",
          "strategy_from": "conflict_strategy",
          "base_versions": "base_versions",
          "merge": [
            {
              "path": "/content",
              "strategy": "automerge",
              "group_by": ["/kind"]
            }
          ],
          "otherwise": "mvcc"
        },
        "publication": {
          "mode": "immediate"
        }
      }
    },
    "knowledge_relation": {
      "value_schema": {
        "$ref": "urn:patchouli:schema:knowledge-relation:1"
      },
      "rules": [
        {
          "name": "transaction_batch",
          "when": {
            "all_present": ["transaction_id", "participant_id", "request_id"]
          },
          "behavior": {
            "consistency": {
              "snapshot": {
                "mode": "shared",
                "key_by": ["transaction_id"]
              },
              "acquire": {
                "allow_sources": ["authority"],
                "requirements": [
                  {
                    "kind": "causal_after",
                    "token": "causal_token",
                    "optional": true
                  }
                ]
              },
              "sessions": [
                {
                  "key_by": ["participant_id"],
                  "guarantees": ["monotonic_reads", "read_your_writes"]
                }
              ],
              "commit": {
                "ordering": {
                  "kind": "serialize",
                  "key_by": []
                }
              }
            },
            "idempotency": {
              "mode": "keyed",
              "key_by": ["transaction_id", "participant_id", "request_id"]
            },
            "conflict": {
              "default_strategy": "mvcc",
              "strategy_from": "conflict_strategy",
              "base_versions": "base_versions",
              "merge": [],
              "otherwise": "mvcc"
            },
            "publication": {
              "mode": "batch",
              "key_by": ["transaction_id"],
              "close_when": {
                "kind": "marker",
                "field": "transaction_state",
                "equals": "commit"
              },
              "staging_ttl_ms": 3600000,
              "on_expire": "discard"
            }
          }
        }
      ],
      "fallback": {
        "consistency": {
          "snapshot": {
            "mode": "request"
          },
          "acquire": {
            "allow_sources": ["authority"],
            "requirements": [
              {
                "kind": "linearizable",
                "key_by": []
              }
            ]
          },
          "sessions": [],
          "commit": {
            "ordering": {
              "kind": "serialize",
              "key_by": []
            }
          }
        },
        "idempotency": {
          "mode": "disabled"
        },
        "conflict": {
          "default_strategy": "mvcc",
          "strategy_from": "conflict_strategy",
          "base_versions": "base_versions",
          "merge": [],
          "otherwise": "mvcc"
        },
        "publication": {
          "mode": "immediate"
        }
      }
    }
  }
}
