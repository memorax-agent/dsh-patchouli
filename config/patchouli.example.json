{
  "$schema": "./patchouli.schema.json",
  "version": 1,
  "meta_fields": {
    "channel_id": {
      "pointer": "/channel_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "transaction_id": {
      "pointer": "/transaction_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "event_time": {
      "pointer": "/event_time",
      "schema": { "type": "string", "format": "date-time" }
    },
    "participant_id": {
      "pointer": "/plugin_route_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "request_id": {
      "pointer": "/request_id",
      "schema": { "type": "string", "minLength": 1 }
    },
    "transaction_state": {
      "pointer": "/transaction_state",
      "schema": { "type": "string" }
    },
    "causal_token": {
      "pointer": "/causal_token",
      "schema": { "type": "string", "minLength": 1 }
    },
    "base_versions": {
      "pointer": "/base_versions",
      "schema": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "uniqueItems": true
      }
    }
  },
  "entity_identity": {
    "scope_by": ["channel_id"]
  },
  "entity_types": {
    "knowledge": {
      "value_schema": {
        "$ref": "urn:patchouli:schema:knowledge:1"
      },
      "rules": [
        {
          "name": "transaction_batch",
          "when": {
            "all_present": ["transaction_id", "event_time", "participant_id"]
          },
          "behavior": {
            "baseline": {
              "mode": "shared",
              "consistency": "causal",
              "source": "replica",
              "key_by": ["channel_id", "transaction_id"],
              "at": "event_time",
              "causal_token": "causal_token"
            },
            "idempotency": {
              "mode": "keyed",
              "key_by": ["channel_id", "transaction_id", "participant_id", "request_id"]
            },
            "conflict": {
              "strategy": "preserve_heads",
              "base_versions": "base_versions"
            },
            "publication": {
              "mode": "batch",
              "key_by": ["channel_id", "transaction_id"],
              "close_when": {
                "kind": "marker",
                "field": "transaction_state",
                "equals": "commit"
              },
              "staging_ttl_ms": 3600000,
              "on_expire": "discard"
            }
          }
        }
      ],
      "fallback": {
        "baseline": {
          "mode": "request",
          "consistency": "linearizable",
          "source": "authority"
        },
        "idempotency": {
          "mode": "disabled"
        },
        "conflict": {
          "strategy": "reject",
          "base_versions": "base_versions"
        },
        "publication": {
          "mode": "immediate"
        }
      }
    },
    "knowledge_relation": {
      "value_schema": {
        "$ref": "urn:patchouli:schema:knowledge-relation:1"
      },
      "rules": [
        {
          "name": "transaction_batch",
          "when": {
            "all_present": ["transaction_id", "event_time", "participant_id"]
          },
          "behavior": {
            "baseline": {
              "mode": "shared",
              "consistency": "causal",
              "source": "replica",
              "key_by": ["channel_id", "transaction_id"],
              "at": "event_time",
              "causal_token": "causal_token"
            },
            "idempotency": {
              "mode": "keyed",
              "key_by": ["channel_id", "transaction_id", "participant_id", "request_id"]
            },
            "conflict": {
              "strategy": "preserve_heads",
              "base_versions": "base_versions"
            },
            "publication": {
              "mode": "batch",
              "key_by": ["channel_id", "transaction_id"],
              "close_when": {
                "kind": "marker",
                "field": "transaction_state",
                "equals": "commit"
              },
              "staging_ttl_ms": 3600000,
              "on_expire": "discard"
            }
          }
        }
      ],
      "fallback": {
        "baseline": {
          "mode": "request",
          "consistency": "linearizable",
          "source": "authority"
        },
        "idempotency": {
          "mode": "disabled"
        },
        "conflict": {
          "strategy": "reject",
          "base_versions": "base_versions"
        },
        "publication": {
          "mode": "immediate"
        }
      }
    }
  }
}
