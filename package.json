{
  "name": "dsh-patchouli",
  "version": "0.1.0",
  "description": "Native knowledge context for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm --filter @memorax-agent/patchouli-protocol run build && pnpm --filter @memorax-agent/dsh-memory-ui run build",
    "build:host": "pnpm run clean:host && tsc -p tsconfig.json",
    "clean:host": "node --eval \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @memorax-agent/patchouli-protocol run typecheck && pnpm --filter @memorax-agent/dsh-memory-ui run typecheck",
    "test": "pnpm run build && node --test",
    "check": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build:host"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "zh-CN": "Patchouli 知识服务",
        "en": "Patchouli Knowledge Service"
      },
      "summary": {
        "zh-CN": "为 DeepSeek Harness 提供本地知识检索与上下文注入服务。",
        "en": "Provide local knowledge retrieval and context injection for DeepSeek Harness."
      },
      "category": "knowledge"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "cordis",
    "knowledge",
    "context",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorax-agent/dsh-patchouli.git"
  },
  "homepage": "https://github.com/memorax-agent/dsh-patchouli#readme",
  "bugs": {
    "url": "https://github.com/memorax-agent/dsh-patchouli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
