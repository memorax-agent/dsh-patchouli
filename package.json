{
  "name": "dsh-patchouli",
  "version": "0.1.0",
  "description": "Native knowledge context for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./storage": {
      "types": "./lib/storage.d.ts",
      "import": "./lib/storage.js"
    },
    "./cursor-store": {
      "types": "./lib/cursor-store.d.ts",
      "import": "./lib/cursor-store.js"
    },
    "./goojfc": {
      "types": "./lib/goojfc/index.d.ts",
      "import": "./lib/goojfc/index.js"
    },
    "./goojfc/graph-memory": {
      "types": "./lib/goojfc/graph-memory.d.ts",
      "import": "./lib/goojfc/graph-memory.js"
    }
  },
  "files": [
    "lib",
    "patches",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p packages/protocol/tsconfig.json && tsc -p tsconfig.json && pnpm --filter @memorax-agent/dsh-patchouli-agent-loop build && pnpm --filter @memorax-agent/dsh-patchouli-artifact-ingestor build && pnpm --filter @memorax-agent/dsh-patchouli-crud-test-plugin build && pnpm --filter @memorax-agent/dsh-patchouli-session-indexer build && pnpm --filter @memorax-agent/dsh-patchouli-workspace-indexer build",
    "typecheck": "tsc -p packages/protocol/tsconfig.json && tsc -p tsconfig.json && tsc -p tsconfig.tooling.json && pnpm --filter @memorax-agent/dsh-patchouli-agent-loop typecheck && pnpm --filter @memorax-agent/dsh-patchouli-artifact-ingestor typecheck && pnpm --filter @memorax-agent/dsh-patchouli-crud-test-plugin typecheck && pnpm --filter @memorax-agent/dsh-patchouli-session-indexer typecheck && pnpm --filter @memorax-agent/dsh-patchouli-workspace-indexer typecheck",
    "test": "pnpm run build && node --test 'test/*.test.ts' 'packages/protocol/test/*.test.ts'",
    "test:e2e": "pnpm run build && cargo build --locked -p patchouli-server --bin patchouli-db && node --test integration/crud-plugin.ts",
    "check": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "harmony": {
      "patches": [
        "./patches/openviking.patch.cjs",
        "./patches/hindsight.patch.cjs",
        "./patches/memos.patch.cjs",
        "./patches/mneme-inject.patch.cjs",
        "./patches/mneme-service.patch.cjs",
        "./patches/mneme-passive.patch.cjs",
        "./patches/mnemon-inject.patch.cjs",
        "./patches/mnemon-service.patch.cjs",
        "./patches/mnemon-passive.patch.cjs",
        "./patches/memory-gate.patch.cjs",
        "./patches/lingshu.patch.cjs",
        "./patches/graph-memory.patch.cjs",
        "./patches/engramory.patch.cjs",
        "./patches/memory-evolve.patch.cjs"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.5 <0.2.0",
    "dsh-harmony": "^0.3.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@memorax-agent/dsh-patchouli-agent-loop": "workspace:*",
    "@memorax-agent/dsh-patchouli-artifact-ingestor": "workspace:*",
    "@memorax-agent/dsh-patchouli-session-indexer": "workspace:*",
    "@memorax-agent/dsh-patchouli-workspace-indexer": "workspace:*",
    "@memorax-agent/patchouli-protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "knowledge",
    "context"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorax-ai/dsh-patchouli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
